<?xml version="1.0" encoding="UTF-8"?>

<configuration>
    <input>
        <net-file value="straight_120km.net.xml"/>
        <route-files value="straight_120km.rou.xml"/>
        <additional-files value="straight_120km.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
    </time>

    <report>
        <verbose value="true"/>
        <no-step-log value="true"/>
    </report>
</configuration>
